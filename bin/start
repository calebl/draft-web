#!/bin/bash
# Start draft-web on localhost only. The tailnet reaches it through
# `tailscale serve --https=8444 http://127.0.0.1:3000`.
# Installed to ~/.local/share/draft-web/bin/start; see "Running behind
# tailscale serve" in README.md.
set -euo pipefail
cd "$HOME/.local/share/draft-web/app"
bundle exec rails db:prepare
exec bundle exec rails server -b 127.0.0.1 -p "${PORT:-3000}"
