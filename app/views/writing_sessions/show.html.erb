<% content_for :header do %>
  <h3 class="title"><%= @story.title %></h3>
  <div class="header-actions">
    <%= link_to 'Continue', edit_story_writing_session_path(@story, @writing_session), class: 'header-action', data: { 'turbo-action': 'replace' } %>
    <%= link_to 'Back', story_writing_sessions_path(@story), class: 'header-action', data: { 'turbo-action': 'restore' } %>
  </div>
<% end %>
<p class="session-meta">
  <%= @writing_session.created_at.strftime('%B %-d, %Y') %> · <%= pluralize(@writing_session.word_count || 0, 'word') %>
</p>
<%= render 'text', text: @writing_session.text %>
