<!DOCTYPE html>
<html>
  <head>
    <title><%= @title || 'Draft' %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, interactive-widget=resizes-content" name="viewport" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <%= yield :meta %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= pocket_kit_errors_tag %>
    <%= pocket_kit_replay_tag %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "fontawesome-all", "data-mutate-approach": "sync" %>
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js");
      }
    </script>
  </head>
  <body class="<%= controller.controller_name %> <%= controller.action_name %>" data-theme="<%= theme_preference %>" data-recent-stories="<%= recent_stories_json %>">
    <%= render "shared/theme" %>
    <%= render "shared/flash" %>
    <%= yield %>
  </body>
</html>
