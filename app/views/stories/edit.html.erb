<% content_for :header do %>
  <h3 class="title">Edit Story Details</h3>
  <div class="header-actions">
    <%= pocket_kit_feedback %>
    <%= link_to 'View Story', story_path(@story), class: 'header-action', data: {'turbo-action': 'restore'} %>
  </div>
<% end %>
<turbo-frame id="story_title">
  <%= form_with(model: @story, class: 'update-story-form simple-form') do |form| %>
    <%= render "shared/form_errors", model: @story %>
    <%= form.label :title %>
    <%= form.text_field :title, value: @story.title, placeholder: 'Enter title' %>
    <%= form.submit "Update" %>
    <a href="<%= story_path(@story) %>" class="cancel-link">Cancel</a>
  <% end %>
</turbo-frame>
